{
  "name": "powerchain-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @powerchain/bridge dev",
    "build": "pnpm prisma:generate && pnpm --filter @powerchain/bridge build",
    "start": "pnpm --filter @powerchain/bridge start",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm typecheck && pnpm verify:production",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "worker:fees": "pnpm --filter @powerchain/worker-fees start",
    "fees:production:check": "node scripts/service-fee-production-check.mjs",
    "uiux:production:check": "node scripts/uiux-production-check.mjs",
    "data:production:check": "node scripts/data-production-check.mjs",
    "runtime:production:check": "node scripts/runtime-wiring-check.mjs",
    "bridge:production:check": "node scripts/bridge-core-production-check.mjs",
    "claim-assets:production:check": "node scripts/claim-assets-production-check.mjs",
    "wallet:production:check": "node scripts/wallet-chain-production-check.mjs",
    "wallet:portfolio:production:check": "node scripts/wallet-portfolio-production-check.mjs",
    "wallet-uiux:production:check": "node scripts/wallet-uiux-production-check.mjs",
    "wallet-flow-uiux:production:check": "node scripts/wallet-flow-uiux-production-check.mjs",
    "wallet-flow-completion:production:check": "node scripts/wallet-flow-completion-production-check.mjs",
    "wallet-action-safety-uiux:production:check": "node scripts/wallet-action-safety-uiux-production-check.mjs",
    "review-recovery-uiux:production:check": "node scripts/review-recovery-uiux-production-check.mjs",
    "claim-bridge-orchestration-uiux:production:check": "node scripts/claim-bridge-orchestration-uiux-production-check.mjs",
    "operation-recovery-uiux:production:check": "node scripts/operation-recovery-uiux-production-check.mjs",
    "operation-recovery-hardening:production:check": "node scripts/operation-recovery-hardening-production-check.mjs",
    "operation-recovery-contract:production:check": "node scripts/operation-recovery-contract-production-check.mjs",
    "operation-canonical-journal:production:check": "node scripts/operation-canonical-journal-production-check.mjs",
    "operation-consistency:production:check": "node scripts/operation-consistency-production-check.mjs",
    "operation-canonical-recovery:production:check": "node scripts/operation-canonical-recovery-production-check.mjs",
    "verify:production": "pnpm node:check && pnpm node-nvm:production:check && pnpm syntax:check && pnpm workspace:production:check && pnpm fees:production:check && pnpm data:production:check && pnpm runtime:production:check && pnpm bridge:production:check && pnpm claim-assets:production:check && pnpm wallet:production:check && pnpm wallet:portfolio:production:check && pnpm uiux:production:check && pnpm operation-canonical-recovery:production:check && pnpm platform:production:check && pnpm operations:production:check && pnpm failure-safety:production:check && pnpm full:production:check",
    "worker:claims": "pnpm --filter @powerchain/worker-claims start",
    "api:generate": "node scripts/generate-api-registry.mjs",
    "full:production:check": "node scripts/full-production-check.mjs",
    "workspace:production:check": "node scripts/workspace-production-check.mjs && pnpm workspace:config:check",
    "syntax:check": "node scripts/typescript-syntax-check.mjs",
    "validate:dependency-aware": "pnpm env:check && pnpm db:check:migrations && pnpm prisma:generate && pnpm prisma:validate && pnpm typecheck && pnpm build",
    "validate:all": "pnpm verify:production && pnpm validate:dependency-aware",
    "dev:bridge": "pnpm --filter @powerchain/bridge dev",
    "dev:backend": "pnpm --filter @powerchain/backend dev",
    "dev:workers": "pnpm --parallel --filter @powerchain/worker-claims --filter @powerchain/worker-fees dev",
    "build:bridge": "pnpm --filter @powerchain/bridge build",
    "clean": "node scripts/clean.mjs",
    "env:check": "node scripts/env-check.mjs",
    "db:check:migrations": "node scripts/check-migrations.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "preinstall": "node scripts/require-node.mjs && node scripts/require-pnpm.mjs",
    "dev:stack": "pnpm --parallel --filter @powerchain/bridge --filter @powerchain/worker-claims --filter @powerchain/worker-fees dev",
    "workspace:config:check": "node scripts/workspace-config-check.mjs",
    "install:ci": "pnpm install --frozen-lockfile",
    "install:update": "pnpm install --no-frozen-lockfile",
    "check:fast": "pnpm syntax:check && pnpm workspace:production:check",
    "build:production": "pnpm env:check && pnpm db:check:migrations && pnpm prisma:generate && pnpm prisma:validate && pnpm --filter @powerchain/bridge build",
    "node:check": "node scripts/require-node.mjs",
    "nvm:check": "bash scripts/nvm-check.sh",
    "setup": "bash scripts/setup-local.sh",
    "node-nvm:production:check": "node scripts/node-nvm-production-check.mjs",
    "platform:production:check": "node scripts/platform-production-check.mjs",
    "operations:production:check": "node scripts/operations-production-check.mjs",
    "failure-safety:production:check": "node scripts/failure-safety-production-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "dotenv": "17.2.2",
    "prisma": "7.7.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
