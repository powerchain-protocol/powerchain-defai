NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain

# Solana / Sui provider topology (server-only)
POWERCHAIN_SOLANA_RPC_URL=
POWERCHAIN_SOLANA_RPC_FALLBACK_URL=
POWERCHAIN_SUI_RPC_URL=
POWERCHAIN_SUI_RPC_FALLBACK_URL=
POWERCHAIN_SUI_GRAPHQL_URL=
POWERCHAIN_RPC_MAX_CONCURRENCY=32
POWERCHAIN_RPC_MAX_CACHE_ENTRIES=512
POWERCHAIN_CHAIN_HEAD_MAX_AGE_MS=120000

# Canonical PWRC / wPWRC assets
POWERCHAIN_PWRC_SOLANA_MINT=
WPWRC_SUI_COIN_TYPE=
POWERCHAIN_PWRC_EXPECTED_SUPPLY_BASE_UNITS=500000000000000000
POWERCHAIN_PWRC_EXPECTED_DECIMALS=9
POWERCHAIN_PWRC_EXPECTED_SYMBOL=PWRC
POWERCHAIN_WPWRC_EXPECTED_SYMBOL=wPWRC
POWERCHAIN_SOLANA_EXPECTED_GENESIS_HASH=
POWERCHAIN_SUI_EXPECTED_CHAIN_IDENTIFIER=
POWERCHAIN_PWRC_EXPECTED_ASSET_FINGERPRINT=

# Canonical bridge routes / quote runtime
POWERCHAIN_ROUTE_SOLANA_TO_SUI_ID=powerchain-solana-to-sui
POWERCHAIN_ROUTE_SUI_TO_SOLANA_ID=powerchain-sui-to-solana
POWERCHAIN_QUOTE_TTL_MS=60000
POWERCHAIN_BRIDGE_RUNTIME_TTL_MS=20000

# Service-fee control plane
POWERCHAIN_SERVICE_FEE_MAX_BPS=1000
POWERCHAIN_SERVICE_FEE_SOLANA_WALLET=FeeszhrKKEsvxr1kg8LDtPx6BLcEbYHiAThYaxajNhqy
POWERCHAIN_SERVICE_FEE_SUI_WALLET=
POWERCHAIN_SERVICE_FEE_REQUIRE_VERIFICATION=true
POWERCHAIN_FEE_WORKER_INTERVAL_MS=5000
POWERCHAIN_FEE_WORKER_BATCH_SIZE=100
POWERCHAIN_FEE_WORKER_LEASE_MS=60000
POWERCHAIN_FEE_MAX_ATTEMPTS=25
POWERCHAIN_OPERATOR_API_TOKEN=
POWERCHAIN_OPERATOR_ID=powerchain-operator
POWERCHAIN_GOVERNANCE_API_TOKEN=
POWERCHAIN_GOVERNANCE_ID=powerchain-governance

# Claim payout. Signer must be a private server/HSM service; do not expose to browser.
POWERCHAIN_CLAIM_TREASURY_OWNER=
POWERCHAIN_CLAIM_SIGNER_URL=
POWERCHAIN_CLAIM_SIGNER_TOKEN=
POWERCHAIN_CLAIM_WORKER_INTERVAL_MS=5000
POWERCHAIN_CLAIM_WORKER_LEASE_MS=60000

# Helius and market data (server-only)
HELIUS_API_KEY=
POWERCHAIN_HELIUS_RPC_API_URL=https://mainnet.helius-rpc.com
POWERCHAIN_HELIUS_ENHANCED_API_URL=https://api-mainnet.helius-rpc.com
POWERCHAIN_PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=
POWERCHAIN_PYTH_SOL_USD_FEED_ID=
POWERCHAIN_PYTH_SUI_USD_FEED_ID=
POWERCHAIN_PYTH_PWRC_USD_FEED_ID=
BIRDEYE_API_KEY=
POWERCHAIN_PRICE_MAX_AGE_MS=60000
POWERCHAIN_WALLET_ACTIVITY_MAX_AGE_MS=120000

# Browser-safe public navigation/realtime only
NEXT_PUBLIC_POWERCHAIN_REALTIME_WS_URL=
NEXT_PUBLIC_SOLSCAN_BASE_URL=https://solscan.io
NEXT_PUBLIC_SUISCAN_BASE_URL=https://suiscan.xyz

# Browser wallet endpoints (public values only; use dedicated production endpoints)
NEXT_PUBLIC_SOLANA_WALLET_RPC_URL=
NEXT_PUBLIC_SUI_WALLET_RPC_URL=

# Wormhole Connect v6 NTT deployment configuration (browser-safe deployment IDs only).
# JSON must include chains ["Solana","Sui"] and at least one NTT route configured
# with the real deployed token/manager/transceiver identifiers. Never put secrets here.
NEXT_PUBLIC_POWERCHAIN_NTT_CONNECT_CONFIG_JSON=
