# Canonical PWRC Token-2022 policy: transfer-fee extension disabled.
# PowerChain service fees are governed and settled separately from bridge principal.
POWERCHAIN_PWRC_TRANSFER_FEE_BPS=0
POWERCHAIN_PWRC_WITHDRAW_WITHHELD_AUTHORITY=
POWERCHAIN_PWRC_FEE_RECEIVER_TOKEN_ACCOUNT=
# Legacy withheld-fee authority/receiver fields must remain empty for canonical PWRC.
# They are retained only so older deployments fail closed instead of silently changing token policy.
POWERCHAIN_SOLANA_PWRC_FEE_MODE=service-fee-separate

# Solana DEX routing
JUPITER_API_KEY=
POWERCHAIN_RAYDIUM_TRANSACTION_API_URL=https://transaction-v1.raydium.io
