NEXT_TELEMETRY_DISABLED=1
# PowerChain Bridge 1.0.0
# Copy to .env.local for local development. Never commit secrets.
NODE_ENV=development
POWERCHAIN_ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain

# Application / browser-safe origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
