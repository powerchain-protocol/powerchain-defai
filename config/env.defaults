POWERCHAIN_MAIL_WEBHOOK_URL=
POWERCHAIN_MAIL_API_KEY=

# Staking deployment configuration (server-only, fail-closed).
# Program/package IDs and vault/pool objects must be real deployed identifiers.
# Never set POWERCHAIN_SOLANA_STAKING_PROGRAM_ID to the compile-time Stake111... placeholder.
POWERCHAIN_SOLANA_STAKING_PROGRAM_ID=
