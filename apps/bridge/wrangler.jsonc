{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "powerchain-defai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "POWERCHAIN_RUNTIME_PLATFORM": "cloudflare"
  }
}
