POWERCHAIN_DB_MAX_LIFETIME_SECONDS=0
POWERCHAIN_DB_APPLICATION_NAME=powerchain-bridge
POWERCHAIN_WORKER_HEARTBEAT_MAX_AGE_MS=60000

