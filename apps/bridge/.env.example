# Optional icon source. PowerChain PWRC/wPWRC stay bundled locally; SOL/SUI/USDC use Web3 Icons by default.
NEXT_PUBLIC_TOKEN_ICON_PROVIDER=web3icons
# cryptoicons.cc is a licensed asset pack, not assumed to expose a public API. Point this at your licensed/hosted template if used.
NEXT_PUBLIC_CRYPTOICONS_CC_URL_TEMPLATE=

# Optional onramp/payment readiness
POWERCHAIN_STRIPE_ONRAMP_ENABLED=false
STRIPE_SECRET_KEY=
POWERCHAIN_MOONPAY_ENABLED=false
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
POWERCHAIN_COINBASE_PAY_ENABLED=false
COINBASE_PAY_APP_ID=
COINBASE_PAY_API_SECRET=

# Optional transactional mail adapter
POWERCHAIN_MAIL_WEBHOOK_URL=
POWERCHAIN_MAIL_API_KEY=

# PowerChain DeFAI assistant (server-only; optional)
POWERCHAIN_AI_API_URL=
POWERCHAIN_AI_API_KEY=
POWERCHAIN_AI_MODEL=

# Staking deployment configuration (server-only)
POWERCHAIN_SOLANA_STAKING_PROGRAM_ID=
POWERCHAIN_SOLANA_STAKING_VAULT=
POWERCHAIN_SUI_STAKING_PACKAGE_ID=
POWERCHAIN_SUI_STAKING_POOL_OBJECT_ID=

# Optional >=32-character HMAC secret for pseudonymous Vercel IP abuse keys.
POWERCHAIN_IP_HASH_SECRET=

# API access policy. X-Api-Key is server-validated and must never use NEXT_PUBLIC_*.
# Modes: off | optional | required. Use required for externally exposed API deployments.
POWERCHAIN_API_KEY_MODE=optional
# Comma-separated accepted keys. Generate high-entropy values outside source control.
POWERCHAIN_API_KEYS=


