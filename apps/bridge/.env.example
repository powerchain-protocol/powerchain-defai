NEXT_TELEMETRY_DISABLED=1
# PowerChain Bridge 1.0.0
# Copy to .env.local for local development. Never commit secrets.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/powerchain

# Application / browser-safe origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLSCAN_BASE_URL=https://solscan.io
NEXT_PUBLIC_SUISCAN_BASE_URL=https://suiscan.xyz
NEXT_PUBLIC_POWERCHAIN_REALTIME_WS_URL=
NEXT_PUBLIC_POWERCHAIN_REALTIME_WS_FALLBACK_URL=
NEXT_PUBLIC_POWERCHAIN_REALTIME_WS_FALLBACK_URLS=
NEXT_PUBLIC_SOLANA_WALLET_RPC_URL=
NEXT_PUBLIC_SUI_WALLET_RPC_URL=

# Server RPC topology
POWERCHAIN_SOLANA_NETWORK=mainnet-beta
POWERCHAIN_SOLANA_RPC_URL=
POWERCHAIN_SOLANA_RPC_FALLBACK_URL=
POWERCHAIN_SOLANA_RPC_FALLBACK_URLS=
POWERCHAIN_SOLANA_WS_URL=
POWERCHAIN_SOLANA_WS_FALLBACK_URL=
POWERCHAIN_SOLANA_WS_FALLBACK_URLS=
POWERCHAIN_SUI_RPC_URL=
POWERCHAIN_SUI_RPC_FALLBACK_URL=
