{
  "name": "@powerchain/bridge",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain full-stack Next.js application for DeFAI, swaps, Wormhole NTT bridging, staking, wallet operations, and integrations.",
  "license": "MIT",
  "author": {
    "name": "PowerChain"
  },
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "node ../../scripts/next-cli.mjs dev --port 3000",
    "build": "node ../../scripts/next-cli.mjs build",
    "start": "node ../../scripts/next-cli.mjs start --port 3000",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm -w workspace:install:ensure && pnpm -w env:bootstrap && pnpm -w prisma:ensure && node ../../scripts/clean-next-dev-cache.mjs apps/bridge",
    "prebuild": "pnpm -w workspace:install:check && pnpm -w env:check && pnpm -w prisma:ensure",
    "pretypecheck": "pnpm -w workspace:install:check && pnpm -w env:check && pnpm -w prisma:ensure",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cloudflare:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev:standalone": "node ../../scripts/next-cli.mjs dev --port 3000",
    "build:standalone": "node ../../scripts/next-cli.mjs build",
    "start:standalone": "node ../../scripts/next-cli.mjs start --port 3000"
  },
  "dependencies": {
    "@jup-ag/api": "6.0.48",
    "@mysten/dapp-kit-react": "2.1.19",
    "@mysten/sui": "2.26.1",
    "@powerchain/backend": "workspace:*",
    "@powerchain/blockchain": "workspace:*",
    "@powerchain/bridge-core": "workspace:*",
    "@powerchain/chat": "workspace:*",
    "@powerchain/clusters": "workspace:*",
    "@powerchain/database": "workspace:*",
    "@powerchain/protocol": "workspace:*",
    "@powerchain/runtime": "workspace:*",
    "@powerchain/staking": "workspace:*",
    "@powerchain/swap-core": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@walletconnect/solana-adapter": "0.0.9",
    "@web3icons/react": "4.1.20",
    "axios": "1.19.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tweetnacl": "1.0.3",
    "@opennextjs/cloudflare": "1.20.2",
    "@radix-ui/react-icons": "1.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
