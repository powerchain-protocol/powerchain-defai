{
  "name": "@powerchain/worker-claims",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain claims worker for durable claim processing, reconciliation, retries, and recovery.",
  "license": "MIT",
  "author": {
    "name": "PowerChain"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/main.ts",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm -w workspace:install:ensure && pnpm -w env:bootstrap && pnpm -w prisma:ensure",
    "prestart": "pnpm -w workspace:install:check && pnpm -w env:check",
    "pretypecheck": "pnpm -w workspace:install:check && pnpm -w prisma:ensure"
  },
  "dependencies": {
    "@powerchain/backend": "workspace:*",
    "@powerchain/database": "workspace:*",
    "@powerchain/runtime": "workspace:*",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  }
}
