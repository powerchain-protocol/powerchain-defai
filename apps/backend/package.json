{
  "name": "@powerchain/backend",
  "version": "1.0.0",
  "dependencies": {
    "@mysten/sui": "2.23.1",
    "@powerchain/database": "workspace:*",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "5.9.3",
    "tsx": "4.20.6"
  }
}
