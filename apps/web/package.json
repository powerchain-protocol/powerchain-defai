{
  "name": "@powerchain/web",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain DeFAI public marketing website.",
  "license": "MIT",
  "author": { "name": "PowerChain" },
  "engines": { "node": ">=24 <26", "pnpm": ">=11.22.0 <12" },
  "scripts": {
    "dev": "node ../../scripts/next-cli.mjs dev --port 3001",
    "build": "node ../../scripts/next-cli.mjs build",
    "start": "node ../../scripts/next-cli.mjs start --port 3001",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm -w workspace:install:ensure",
    "prebuild": "pnpm -w workspace:install:check",
    "pretypecheck": "pnpm -w workspace:install:check"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.1.14",
    "typescript": "7.0.2"
  }
}
