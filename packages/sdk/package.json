{
  "name": "@powerchain/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "PowerChain TypeScript SDK for integrating protocol, swap, bridge, staking, wallet, and API capabilities.",
  "license": "MIT",
  "author": {
    "name": "PowerChain"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.22.0 <12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@powerchain/protocol": "workspace:*",
    "@powerchain/blockchain": "workspace:*",
    "@powerchain/clusters": "workspace:*",
    "@powerchain/swap-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
