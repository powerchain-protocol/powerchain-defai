{
  "name": "@powerchain/protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Canonical PowerChain protocol configuration, deployment identifiers, token policy, and chain-level constants.",
  "license": "MIT",
  "author": {
    "name": "PowerChain"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=11.22.0 <12"
  },
  "exports": {
    ".": "./src/index.ts",
    "./addresses": "./src/addresses.ts",
    "./explorers": "./src/explorers.ts",
    "./fees": "./src/fees.ts",
    "./integrations": "./src/integrations.ts",
    "./signatures": "./src/signatures.ts",
    "./transactions": "./src/transactions.ts",
    "./validate": "./src/validate.ts",
    "./token-information": "./src/token-information.ts",
    "./assets": "./src/assets.ts",
    "./ecosystem": "./src/ecosystem.ts",
    "./programs": "./src/programs.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "tweetnacl": "1.0.3",
    "@powerchain/blockchain": "workspace:*",
    "@powerchain/clusters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
