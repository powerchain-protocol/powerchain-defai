{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@powerchain/backend": [
        "./apps/backend/src/index.ts"
      ],
      "@powerchain/backend/*": [
        "./apps/backend/src/*"
      ],
      "@powerchain/database": [
        "./packages/database/src/index.ts"
      ],
      "@powerchain/database/*": [
        "./packages/database/src/*"
      ],
      "@powerchain/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@powerchain/protocol": [
        "./packages/protocol/src/index.ts"
      ],
      "@powerchain/protocol/*": [
        "./packages/protocol/src/*"
      ],
      "@powerchain/blockchain": [
        "./shared/blockchain/src/index.ts"
      ],
      "@powerchain/blockchain/*": [
        "./shared/blockchain/src/*"
      ],
      "@powerchain/clusters": [
        "./clusters/src/index.ts"
      ],
      "@powerchain/swap-core": [
        "./packages/swap-core/src/index.ts"
      ],
      "@powerchain/swap-core/*": [
        "./packages/swap-core/src/*"
      ],
      "@powerchain/bridge-core": [
        "./packages/bridge-core/src/index.ts"
      ],
      "@powerchain/bridge-core/*": [
        "./packages/bridge-core/src/*"
      ],
      "@powerchain/chat": [
        "./apps/chat/src/index.ts"
      ],
      "@powerchain/chat/*": [
        "./apps/chat/src/*"
      ],
      "@powerchain/staking": [
        "./apps/staking/src/index.ts"
      ],
      "@powerchain/staking/*": [
        "./apps/staking/src/*"
      ],
      "@powerchain/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@powerchain/sdk/*": [
        "./packages/sdk/src/*"
      ]
    },
    "types": [
      "node"
    ]
  }
}
